# Build-context exclusions. This is NOT the same file as .gitignore: that one
# protects the repository, this one protects the image. A path can be gitignored
# and still end up baked into a layer, which is why `books/` appears in both.

# 22 MB of copyrighted textbooks. The README tells readers to find their own
# copies, so these must never be published or shipped.
books/

# Repository history -- never belongs in an image layer.
.git/
.venv

# Byte-compiled test artifacts, regenerated on every test run.
__pycache__/

# Submission archives and credentials that labs reference but must never ship.
*.zip
*.tar.gz
*.key
*.pem

lab04-artifacts/
